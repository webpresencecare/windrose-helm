{
  "name": "windrose-helm",
  "version": "0.6.5",
  "private": true,
  "description": "Windrose Helm: network admin screens.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build src/admin/index.js --output-path=build/admin && wp-scripts build src/setup/index.js --output-path=build/setup",
    "postbuild": "node bin/guard-build.mjs",
    "start": "wp-scripts start src/admin/index.js --output-path=build/admin",
    "lint:js": "wp-scripts lint-js src"
  },
  "devDependencies": {
    "@wordpress/scripts": "37.1.0"
  },
  "dependencies": {
    "@wordpress/a11y": "5.1.0",
    "@wordpress/api-fetch": "8.1.0",
    "@wordpress/components": "44.0.0",
    "@wordpress/dataviews": "22.0.0",
    "@wordpress/date": "6.1.0",
    "@wordpress/element": "10.1.0",
    "@wordpress/i18n": "7.1.0"
  }
}
